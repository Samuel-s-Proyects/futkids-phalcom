{
  "name": "umg/futkids",
  "description": "Gestión de un torneo infantil de fútbol con Phalcon 5",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "ext-phalcon": ">=5.22.1 <6",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-gd": "*",
    "ext-fileinfo": "*",
    "ext-intl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/php/"}},
  "config": {"sort-packages": true},
  "scripts": {
    "migrate": "php scripts/migrate.php",
    "seed": "php scripts/seed.php",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration",
    "test:migration": "phpunit --testsuite Migration"
  }
}
